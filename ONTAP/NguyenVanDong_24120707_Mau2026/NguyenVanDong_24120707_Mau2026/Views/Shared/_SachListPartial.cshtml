@model IEnumerable<NguyenVanDong_24120707_Mau2026.Models.Sach>

<div class="section-head">
    <h3>@ViewBag.SectionTitle</h3>
    <div>
        <a asp-controller="Home" asp-action="Create" class="create-book-link">+ Thêm sách mới</a>
        <a href="@Url.Action("Index", "Home")">Xem tất cả &rsaquo;</a>
    </div>
</div>
<div class="grid">
    @foreach (var sach in Model)
    {
        <div class="book-card">
            <a href="#"><img src="~/images/@sach.Anh" alt="@sach.TenSach" /></a>
            <h2>@sach.TenSach</h2>
            <div class="book-foot"><span class="price">@sach.Gia</span><button class="btn-buy">Thêm vào giỏ</button></div>
        </div>
    }

</div>
