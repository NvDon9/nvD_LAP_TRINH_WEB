@{
    ViewData["Title"] = "Thông tin sản phẩm";
}
<h1>@ViewData["Title"]</h1>
<hr />
<div class="alert alert-danger">
    <h2>lấy từ ViewBag </h2>
    <p>ID: @ViewBag.productVB.productId</p>
    <p>Tên: @ViewBag.productVB.productName</p>
    <p>Số lượng: @ViewBag.productVB.quantity</p>
    <p>Giá: @ViewBag.productVB.price</p>
</div>
<hr />

@{// chuyển đổi kiểu dữ liệu

    var product = ViewData["productVD"] as nvD_Lesson2.Models.NvdProduct;
}

<div class="alert alert-info">
    <h2>lấy từ ViewData </h2>
    <p>ID: @product.productId</p>
    <p>Tên: @product.productName</p>
    <p>Số lượng: @product.quantity</p>
    <p>Giá: @product.price</p>
</div>