@model List<Lesson06_Model.Models.NvdMember>

<h2>Danh sách thành viên</h2>
<a asp-action="NVD_Create" class="btn btn-primary">Thêm mới</a>
<table class="table table-bordered">
    <tr>
        <th>Mã thành viên</th>
        <th>Username</th>
        <th>Họ và tên</th>
        <th>Email</th>
    </tr>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.NVD_MemberID</td>
            <td>@m.NVD_UserName</td>
            <td>@m.NVD_FullName</td>
            <td>@m.NVD_Email</td>
            <td>
                <a asp-action="NVD_Edit" asp-route-id="@m.NVD_MemberID" class="btn btn-sm btn-warning">Sửa</a>
                <a asp-action="NVD_Delete" asp-route-id="@m.NVD_MemberID" class="btn btn-sm btn-danger">Xóa</a>
            </td>
        </tr>
    }
</table>