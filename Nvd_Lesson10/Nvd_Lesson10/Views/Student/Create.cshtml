@model Student
@{
    ViewData["Title"] = "Thêm sinh viên";
}
<div class="container py-3">
    <h2>Thêm sinh viên</h2>
    <form asp-controller="Student" asp-action="Create" method="post" class="mt-3">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group row mt-2">
            <label asp-for="name" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10"><input asp-for="name" class="form-control" placeholder="Họ tên" /><span asp-validation-for="name" class="text-danger"></span></div>
        </div>
        <div class="form-group row mt-2">
            <label asp-for="email" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10"><input asp-for="email" class="form-control" placeholder="ten@gmail.com" /><span asp-validation-for="email" class="text-danger"></span></div>
        </div>
        <div class="form-group row mt-2">
            <label asp-for="Password" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10"><input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu" /><span asp-validation-for="Password" class="text-danger"></span></div>
        </div>
        <div class="form-group row mt-2">
            <label asp-for="Branch" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10"><select asp-for="Branch" class="form-select" asp-items="ViewBag.AllBranches"><option value="">-- Chọn ngành --</option></select><span asp-validation-for="Branch" class="text-danger"></span></div>
        </div>
        <div class="form-group row mt-2">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10"><input asp-for="IsRegular" class="form-check-input" /></div>
        </div>
        <div class="form-group row mt-2">
            <label asp-for="DateOfBorth" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10"><input asp-for="DateOfBorth" type="date" class="form-control" /><span asp-validation-for="DateOfBorth" class="text-danger"></span></div>
        </div>
        <div class="form-group row mt-2">
            <label asp-for="Gender" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                @foreach (var gender in ViewBag.AllGenders)
                {
                    <label class="form-check form-check-inline"><input type="radio" asp-for="Gender" value="@gender" class="form-check-input" /> @((Gender)gender == Gender.Male ? "Nam" : "Nữ")</label>
                }
                <div><span asp-validation-for="Gender" class="text-danger"></span></div>
            </div>
        </div>
        <div class="form-group row mt-2">
            <label asp-for="Address" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10"><textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea><span asp-validation-for="Address" class="text-danger"></span></div>
        </div>
        <div class="form-group row mt-2">
            <label asp-for="Score" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10"><input asp-for="Score" type="number" min="0" max="10" step="0.1" class="form-control" placeholder="0 - 10" /><span asp-validation-for="Score" class="text-danger"></span></div>
        </div>
        <div class="mt-3"><button type="submit" class="btn btn-primary">Tạo</button></div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
