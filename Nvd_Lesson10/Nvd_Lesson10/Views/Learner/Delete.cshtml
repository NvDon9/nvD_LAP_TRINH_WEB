@model Nvd_Lesson10.Models.Learner
@{
    ViewData["Title"] = "Delete Learner";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Delete Learner</h1>
    <h4>Are you sure you want to delete this learner?</h4>

    @if (TempData["DeleteError"] is string message)
    {
        <div class="alert alert-warning">@message</div>
    }

    <dl class="row">
        <dt class="col-sm-2">First name</dt>
        <dd class="col-sm-10">@Model.FirstMidName</dd>
        <dt class="col-sm-2">Last name</dt>
        <dd class="col-sm-10">@Model.LastName</dd>
        <dt class="col-sm-2">Major</dt>
        <dd class="col-sm-10">@Model.Major?.MajorName</dd>
        <dt class="col-sm-2">Enrollment date</dt>
        <dd class="col-sm-10">@Model.EnrollmentDate.ToShortDateString()</dd>
    </dl>

    @if (Model.Enrollments.Count > 0)
    {
        <p class="text-danger">Learner này có đăng ký khóa học nên không thể xóa.</p>
    }
    else
    {
        <form asp-action="Delete" asp-route-id="@Model.LearnerID" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Back to list</a>
        </form>
    }
</div>
