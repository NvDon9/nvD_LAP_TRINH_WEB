@model Nvd_Lesson10.Models.Learner
@{
    ViewData["Title"] = "Edit Learner";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Learner</h1>
    <form asp-action="Edit" asp-route-id="@Model.LearnerID" method="post" class="mt-3">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="LearnerID" />

        <div class="form-group row mt-2">
            <label asp-for="FirstMidName" class="col-sm-2 col-form-label">First name</label>
            <div class="col-sm-10">
                <input asp-for="FirstMidName" class="form-control" />
                <span asp-validation-for="FirstMidName" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group row mt-2">
            <label asp-for="LastName" class="col-sm-2 col-form-label">Last name</label>
            <div class="col-sm-10">
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group row mt-2">
            <label asp-for="MajorID" class="col-sm-2 col-form-label">Major</label>
            <div class="col-sm-10">
                <select asp-for="MajorID" class="form-select" asp-items="ViewBag.MajorID">
                    <option value="">-- Select a major --</option>
                </select>
                <span asp-validation-for="MajorID" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group row mt-2">
            <label asp-for="EnrollmentDate" class="col-sm-2 col-form-label">Enrollment date</label>
            <div class="col-sm-10">
                <input asp-for="EnrollmentDate" type="date" class="form-control" />
                <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Edit</button>
            <a asp-action="Index" class="btn btn-secondary">Back to list</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
