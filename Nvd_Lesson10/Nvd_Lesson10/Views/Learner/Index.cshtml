@model IEnumerable<Nvd_Lesson10.Models.Learner>
@{
    ViewData["Title"] = "Learner List";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Learner List</h1>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên</th>
                <th>Họ</th>
                <th>Ngành</th>
                <th>Ngày nhập học</th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var learner in Model)
        {
            <tr>
                <td>@learner.LearnerID</td>
                <td>@learner.FirstMidName</td>
                <td>@learner.LastName</td>
                <td>@learner.Major?.MajorName</td>
                <td>@learner.EnrollmentDate.ToShortDateString()</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@learner.LearnerID">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@learner.LearnerID">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <a asp-action="Create" class="btn btn-primary">Create New Learner</a>
</div>
