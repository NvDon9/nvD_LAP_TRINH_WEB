<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AssetHub - Quản lý tài sản doanh nghiệp</title>
    <link href="~/css/layout.css" rel="stylesheet" type="text/css" />
    <link href="~/css/style.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Begin Header -->
    <partial name="NguyenVanDong_Header" />
    <!-- End Header -->
    <!-- Begin Main Content -->
    <main class="main">
        @RenderBody()
    </main>
    <!-- End Main Content -->
    <!-- Begin Footer -->
    <footer class="footer">
        <partial name="NguyenVanDong_Footer" />
    </footer>
    <!-- End Footer -->

    <div class="to-top">&uarr;</div>
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/main.js"></script>

    <script>
            $(document).ready(function () {
                $(".Fiuter").click(function (e) {
                    e.preventDefault();

                    // Đổi trạng thái active trên thanh menu
                    $(".menu li").removeClass("active");
                    $(this).parent().addClass("active");

                    var maLoai = $(this).data("maloai");
                    var tenLoai = $(this).text();

                    // Đổi tên tiêu đề của phần hiển thị tài sản
                    $("#section-title").text(tenLoai);

                    // Gọi AJAX để lấy danh sách tài sản theo mã loại
                    $.ajax({
                        url: "/Home/FillterbyLoai",
                        type: "GET",
                        data: { maLoai: maLoai },
                        success: function (data) {
                            $("#asset-grid").html(data);
                        },
                        error: function () {
                            alert("Lỗi khi tải dữ liệu");
                        }
                    });
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>